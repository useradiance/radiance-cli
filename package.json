{
  "name": "radiance-cli",
  "version": "0.2.0",
  "description": "Build Expo + Firebase apps from the Radiance template catalogue, with a template-first AI prompt harness.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "radiance": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/useradiance/radiance-cli.git"
  },
  "keywords": [
    "expo",
    "react-native",
    "firebase",
    "scaffolding",
    "codegen",
    "ai"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \".test-build/tests/*.test.js\"",
    "bootstrap:starters": "node scripts/bootstrap-starters.mjs",
    "compile:check": "node dist/index.js compile",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "yarn build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@clack/prompts": "^1.7.0",
    "@cursor/sdk": "^1.0.27",
    "@napi-rs/keyring": "^1.3.0",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "execa": "^10.0.1",
    "fast-glob": "^3.3.3",
    "openai": "^7.4.0",
    "picocolors": "^1.1.1",
    "semver": "^7.8.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/semver": "^7.7.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
